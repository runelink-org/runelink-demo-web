{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "import",
    "promise",
    "oxc",
    "node",
    "react",
    "jsx-a11y"
  ],
  "jsPlugins": [
    "./tools/oxlint-plugin-t3code/index.ts",
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    }
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "ignorePatterns": [
    "dist",
    "tools/oxlint-plugin-t3code"
  ],
  "rules": {
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "TryStatement",
        "message": "Use Option.liftThrowable or a typed Effect adapter for fallible operations."
      }
    ],
    "eslint/capitalized-comments": [
      "error",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "eslint/class-methods-use-this": [
      "error",
      {
        "ignoreOverrideMethods": true
      }
    ],
    "eslint/complexity": "off",
    "eslint/curly": [
      "error",
      "multi-line"
    ],
    "eslint/default-case": "off",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/func-names": "off",
    "eslint/func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "eslint/id-length": "off",
    "eslint/init-declarations": "off",
    "eslint/max-classes-per-file": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/new-cap": "off",
    "eslint/no-continue": "off",
    "eslint/no-duplicate-imports": [
      "error",
      {
        "allowSeparateTypeImports": true
      }
    ],
    "eslint/no-eq-null": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-negated-condition": "off",
    "eslint/no-plusplus": "off",
    "eslint/no-ternary": "off",
    "eslint/no-undef": "off",
    "eslint/no-undefined": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false
      }
    ],
    "eslint/no-void": "off",
    "eslint/no-warning-comments": "off",
    "eslint/one-var": "off",
    "eslint/prefer-named-capture-group": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "import/exports-last": "off",
    "import/group-exports": "off",
    "import/max-dependencies": "off",
    "import/no-default-export": "error",
    "import/no-named-export": "off",
    "import/no-namespace": "off",
    "import/no-nodejs-modules": "error",
    "import/no-relative-parent-imports": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css"
        ]
      }
    ],
    "import/prefer-default-export": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "node/no-sync": "off",
    "node/no-top-level-await": "off",
    "oxc/no-async-await": "off",
    "oxc/no-barrel-file": "off",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "promise/prefer-await-to-callbacks": "off",
    "promise/prefer-await-to-then": "off",
    "react/forbid-component-props": "off",
    "react/hook-use-state": "off",
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": [
          ".tsx"
        ]
      }
    ],
    "react/jsx-max-depth": "off",
    "react/jsx-no-literals": "off",
    "react/jsx-props-no-spreading": "off",
    "react/no-multi-comp": "off",
    "react/react-in-jsx-scope": "off",
    "react/todo": "off",
    "t3code/no-real-time-wait-in-tests": "error",
    "t3code/no-wall-clock-in-tests": "error",
    "t3code/prefer-effect-fn": "error",
    "t3code/require-suppression-reason": "error",
    "typescript/consistent-return": "off",
    "typescript/consistent-type-definitions": "off",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-member-accessibility": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/promise-function-async": "off",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowNullableBoolean": true
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "unicorn/filename-case": [
      "error",
      {
        "cases": {
          "kebabCase": true,
          "pascalCase": true
        }
      }
    ],
    "unicorn/max-nested-calls": "off",
    "unicorn/no-array-callback-reference": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-array-method-this-argument": "off",
    "unicorn/no-nested-ternary": "off",
    "unicorn/no-null": "off",
    "unicorn/no-useless-undefined": "off",
    "unicorn/prefer-global-this": "off",
    "unicorn/throw-new-error": "off"
  },
  "overrides": [
    {
      "files": [
        "tests/**",
        "*.config.ts"
      ],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      "files": [
        "*.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": [
        "src/lib/runelink-debug.ts"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
